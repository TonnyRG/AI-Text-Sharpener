# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Virtual envs
.venv/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
tests/fixtures/output/

# Editor / IDE
.claude/
.DS_Store

# Logs
*.log

# Syncthing
.stfolder/

# Per-machine assets (fonts that the user installs locally, often huge .ttc files)
fonts/

# Top-level scratch / diagnostic output (regeneratable)
output/
tmp/
audit/

# Local PPT inputs + extracted assets (not part of the repo)
PPT/

# scripts/ — Python sources are committed; everything else is scratch
scripts/__pycache__/
scripts/*.png
scripts/*.jpg
scripts/*.svg
scripts/*.json

# examples/before_after — large generated assets; never committed.  Users regenerate
# from scripts/run_all.py with their own corpus.
examples/before_after/

# examples/ppt_reviews — full review projects (slides, drafts, finals); per-project,
# can be huge.  Don't commit; users regenerate from their own PPTs.
examples/ppt_reviews/

.venv-formula/
